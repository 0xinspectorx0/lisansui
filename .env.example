# Kopyala: .env.local  (Expo her iki dosyayı da otomatik okur; .env.local commit'lenmez)
# Yeni Firestore projen:
EXPO_PUBLIC_FIRESTORE_PROJECT=kpss-prod
# Koleksiyonları veritabanı kökünde tutmak için '.' bırak:
EXPO_PUBLIC_FIRESTORE_ROOT=.
# Opsiyonel:
EXPO_PUBLIC_FIRESTORE_DATABASE=(default)
# Yerel Firestore emulator'ü ile test:
# EXPO_PUBLIC_FIRESTORE_HOST=http://localhost:8080/v1

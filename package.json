{
  "name": "expo-router-ts",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "~7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.26",
    "expo-asset": "^57.0.18",
    "expo-constants": "^57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "^57.0.5",
    "expo-secure-store": "^57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.28.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build:serve": "npx serve dist -l 8081 -s",
    "migrate:content:selftest": "node scripts/migrate-to-supabase.mjs --self-test",
    "test:copy": "bash scripts/copy-contract.sh",
    "test:bulk": "bash scripts/bulk-contract.sh",
    "test:ui": "bash scripts/admin-ui.sh",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "check:supabase": "node scripts/setup-supabase.mjs --check",
    "sync:sql": "node scripts/sync-sql-copy.mjs",
    "sync:sql:check": "node scripts/sync-sql-copy.mjs --check",
    "test:db": "bash scripts/db-contract.sh",
    "prebuild": "node scripts/sync-sql-copy.mjs --check",
    "verify": "npm run sync:sql:check && npm run test:db && npm run test:ui && npm run test:bulk && npm run test:copy && npm run migrate:content:selftest",
    "migrate:content": "node scripts/migrate-to-supabase.mjs"
  },
  "private": true
}
